{
  "name": "dsh-local-file-share",
  "version": "1.0.0",
  "description": "Local File Share / 本地文件共享 — let the dsh agent list, read and write files on the machine that runs your browser, through a private WebSocket relay and the File System Access API. Zero data copied onto the dsh host.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "deepseekharness",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "local-file-share",
    "file-system-access",
    "browser-files",
    "local-files",
    "websocket",
    "agent",
    "remote-development",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseekharness-dsh/dsh-local-file-share.git"
  },
  "homepage": "https://github.com/deepseekharness-dsh/dsh-local-file-share#readme",
  "bugs": {
    "url": "https://github.com/deepseekharness-dsh/dsh-local-file-share/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run build && npm run typecheck && npm run smoke",
    "prepublishOnly": "npm run verify",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "@types/wicg-file-system-access": "^2023.10.5",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
